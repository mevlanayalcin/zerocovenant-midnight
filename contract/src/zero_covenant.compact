// ZeroCovenant — Privacy-Preserving Institutional Proof-of-Solvency,
// Concentration Risk Covenant & Selective Auditor Disclosure on Midnight.
// SPDX-License-Identifier: Apache-2.0

pragma language_version >= 0.20;

import CompactStandardLibrary;

export ledger epoch: Counter;
export ledger attestationCount: Counter;
export ledger entityCommitment: Bytes<32>;
export ledger covenantMinRatioBps: Uint<64>;
export ledger covenantMaxSingleBps: Uint<64>;
export ledger lastSolvencyRoot: Bytes<32>;
export ledger lastSolvencyVerified: Boolean;
export ledger lastAttestedEpoch: Uint<64>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger epochRoots: Map<Uint<64>, Bytes<32>>;
export ledger auditorGrants: Map<Bytes<32>, Bytes<32>>;

witness localDeskSecret(): Bytes<32>;
witness getCustodianBalances(): Vector<4, Uint<64>>;
witness getTotalLiabilities(): Uint<64>;
witness getEpochSalt(): Bytes<32>;

export pure circuit deriveEntityCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zc:entity:v1"), sk]);
}

export pure circuit computeReserveRoot(
  entityCommit: Bytes<32>,
  epochVal: Uint<64>,
  b0: Uint<64>,
  b1: Uint<64>,
  b2: Uint<64>,
  b3: Uint<64>,
  liabilities: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<9, Bytes<32>>>([
    pad(32, "zc:root:v2"),
    entityCommit,
    (epochVal as Field) as Bytes<32>,
    (b0 as Field) as Bytes<32>,
    (b1 as Field) as Bytes<32>,
    (b2 as Field) as Bytes<32>,
    (b3 as Field) as Bytes<32>,
    (liabilities as Field) as Bytes<32>,
    salt
  ]);
}

// Cross-epoch anti-replay nullifier: omitting epoch ensures reusing a blinding
// salt across ANY epoch triggers "Nullifier replay detected".
export pure circuit computeNullifier(sk: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "zc:nullifier:v2"),
    sk,
    salt
  ]);
}

export pure circuit computeGrantKey(auditorPk: Bytes<32>, targetEpoch: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "zc:grant:v1"),
    auditorPk,
    (targetEpoch as Field) as Bytes<32>
  ]);
}

// One-way disclosure tag bound strictly to the attested epoch root, auditor PK,
// and target epoch — zero exposure of deskSecret.
export pure circuit computeDisclosureTag(
  epochRoot: Bytes<32>,
  auditorPk: Bytes<32>,
  targetEpoch: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "zc:disclosure:v2"),
    epochRoot,
    auditorPk,
    (targetEpoch as Field) as Bytes<32>
  ]);
}

constructor(initialMinRatioBps: Uint<64>, initialMaxSingleBps: Uint<64>) {
  const initMin = disclose(initialMinRatioBps);
  const initMax = disclose(initialMaxSingleBps);
  assert(initMin >= 10000, "Minimum solvency ratio must be >= 10000 bps (100%)");
  assert(initMax >= 2500 && initMax <= 10000, "Concentration cap must be 2500..10000 bps for 4 custodians");

  const sk = localDeskSecret();
  entityCommitment = disclose(deriveEntityCommitment(sk));
  covenantMinRatioBps = initMin;
  covenantMaxSingleBps = initMax;
  lastSolvencyVerified = false;
  lastAttestedEpoch = 0;
  epoch.increment(1);
}

export circuit attestSolvency(): Bytes<32> {
  const sk = localDeskSecret();
  assert(disclose(entityCommitment == deriveEntityCommitment(sk)), "Unauthorized desk secret key");

  const b = getCustodianBalances();
  const liabilities = getTotalLiabilities();
  const salt = getEpochSalt();

  const totalAssets = b[0] + b[1] + b[2] + b[3];

  assert(totalAssets > 0, "Total reserves must be strictly positive");
  assert(liabilities > 0, "Total liabilities must be strictly positive");

  // Zero-knowledge solvency inequality: totalAssets * 10000 >= liabilities * covenantMinRatioBps
  assert(totalAssets * 10000 >= liabilities * covenantMinRatioBps, "Solvency covenant ratio breached");

  // Zero-knowledge concentration risk check across all 4 private custodians
  const maxAllowed = totalAssets * covenantMaxSingleBps;
  assert(b[0] * 10000 <= maxAllowed, "Custodian 0 concentration exceeds covenant cap");
  assert(b[1] * 10000 <= maxAllowed, "Custodian 1 concentration exceeds covenant cap");
  assert(b[2] * 10000 <= maxAllowed, "Custodian 2 concentration exceeds covenant cap");
  assert(b[3] * 10000 <= maxAllowed, "Custodian 3 concentration exceeds covenant cap");

  // Cross-epoch anti-replay nullifier binding desk secret and blinding salt
  const curEpoch = epoch as Uint<64>;
  const nul = disclose(computeNullifier(sk, salt));
  assert(!usedNullifiers.member(nul), "Nullifier replay detected");
  usedNullifiers.insert(nul);

  const root = disclose(
    computeReserveRoot(entityCommitment, curEpoch, b[0], b[1], b[2], b[3], liabilities, salt)
  );
  epochRoots.insert(curEpoch, root);
  lastSolvencyRoot = root;
  lastSolvencyVerified = true;
  lastAttestedEpoch = curEpoch;
  attestationCount.increment(1);
  epoch.increment(1);
  return root;
}

export circuit grantAuditorDisclosure(auditorPk: Bytes<32>, targetEpoch: Uint<64>): Bytes<32> {
  const sk = localDeskSecret();
  assert(disclose(entityCommitment == deriveEntityCommitment(sk)), "Unauthorized desk secret key");
  const epochDisclosed = disclose(targetEpoch);
  const auditorDisclosed = disclose(auditorPk);
  assert(epochDisclosed > 0 && epochDisclosed <= lastAttestedEpoch, "Invalid target epoch");
  assert(epochRoots.member(epochDisclosed), "Target epoch root not found");

  const epochRoot = epochRoots.lookup(epochDisclosed);
  const grantKey = computeGrantKey(auditorDisclosed, epochDisclosed);
  const tag = computeDisclosureTag(epochRoot, auditorDisclosed, epochDisclosed);
  auditorGrants.insert(grantKey, tag);
  return tag;
}

export circuit tightenCovenantPolicy(newMinRatioBps: Uint<64>, newMaxSingleBps: Uint<64>): [] {
  const sk = localDeskSecret();
  assert(disclose(entityCommitment == deriveEntityCommitment(sk)), "Unauthorized desk secret key");
  const nextMin = disclose(newMinRatioBps);
  const nextMax = disclose(newMaxSingleBps);
  assert(nextMin >= 10000, "Solvency ratio must be >= 10000 bps");
  assert(nextMax >= 2500 && nextMax <= 10000, "Concentration cap must be 2500..10000 bps for 4 custodians");
  assert(nextMin >= covenantMinRatioBps, "Covenant solvency ratio can only tighten");
  assert(nextMax <= covenantMaxSingleBps, "Covenant concentration cap can only tighten");

  covenantMinRatioBps = nextMin;
  covenantMaxSingleBps = nextMax;
  lastSolvencyVerified = false;
}
